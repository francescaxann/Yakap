    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "user",
        "name": "scoped_profiles",
        "as": "PERMISSIVE",
        "for": "SELECT",
        "roles": [
          "yakap_app"
        ],
        "using": "\"user\".\"email_verified\" AND (\n      \n  current_setting('yakap.scope', true) = 'moderation' AND EXISTS (\n    SELECT 1 FROM public.moderators WHERE email = current_setting('yakap.actor_email', true)\n  )\n OR\n      (current_setting('yakap.scope', true) = 'submission' AND \"user\".\"id\" = current_setting('yakap.actor_id', true) AND \"user\".\"email\" = current_setting('yakap.actor_email', true))\n    )",
        "withCheck": null,
        "entityType": "policies"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "verification",
        "name": "auth_scope",
        "as": "PERMISSIVE",
        "for": "ALL",
        "roles": [
          "yakap_app"
        ],
        "using": "current_setting('yakap.scope', true) = 'auth'",
        "withCheck": "current_setting('yakap.scope', true) = 'auth'",
        "entityType": "policies"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "moderators",
        "name": "read_memberships",
        "as": "PERMISSIVE",
        "for": "SELECT",
        "roles": [
          "yakap_app"
        ],
        "using": "current_setting('yakap.scope', true) IN ('bootstrap', 'manage-moderators') OR (\n      current_setting('yakap.scope', true) IN ('membership', 'moderation') AND \"moderators\".\"email\" = current_setting('yakap.actor_email', true)\n    )",
        "withCheck": null,
        "entityType": "policies"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "moderators",
        "name": "add_membership",
        "as": "PERMISSIVE",
        "for": "INSERT",
        "roles": [
          "yakap_app"
        ],
        "using": null,
        "withCheck": "current_setting('yakap.scope', true) IN ('bootstrap', 'manage-moderators')",
        "entityType": "policies"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "moderators",
        "name": "remove_other_membership",
        "as": "PERMISSIVE",
        "for": "DELETE",
        "roles": [
          "yakap_app"
        ],
        "using": "current_setting('yakap.scope', true) = 'manage-moderators' AND \"moderators\".\"email\" <> current_setting('yakap.actor_email', true)",
        "withCheck": null,
        "entityType": "policies"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "letters",
        "name": "read_visible_letters",
        "as": "PERMISSIVE",
        "for": "SELECT",
        "roles": [
          "yakap_app"
        ],
        "using": "(current_setting('yakap.scope', true) = 'public' AND \"letters\".\"status\" = 'approved') OR (current_setting('yakap.scope', true) = 'submission' AND \"letters\".\"sender_id\" = current_setting('yakap.actor_id', true) AND \"letters\".\"sender_email\" = current_setting('yakap.actor_email', true)) OR (\n  current_setting('yakap.scope', true) = 'moderation' AND EXISTS (\n    SELECT 1 FROM public.moderators WHERE email = current_setting('yakap.actor_email', true)\n  )\n)",
        "withCheck": null,
        "entityType": "policies"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "letters",
        "name": "submit_own_pending_letter",
        "as": "PERMISSIVE",
        "for": "INSERT",
        "roles": [
          "yakap_app"
        ],
        "using": null,
        "withCheck": "(current_setting('yakap.scope', true) = 'submission' AND \"letters\".\"sender_id\" = current_setting('yakap.actor_id', true) AND \"letters\".\"sender_email\" = current_setting('yakap.actor_email', true)) AND \"letters\".\"status\" = 'pending' AND EXISTS (\n        SELECT 1 FROM public.\"user\" WHERE id = current_setting('yakap.actor_id', true) AND email = current_setting('yakap.actor_email', true) AND email_verified\n      )",
        "entityType": "policies"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "letters",
        "name": "moderate_letters",
        "as": "PERMISSIVE",
        "for": "UPDATE",
        "roles": [
          "yakap_app"
        ],
        "using": "(\n  current_setting('yakap.scope', true) = 'moderation' AND EXISTS (\n    SELECT 1 FROM public.moderators WHERE email = current_setting('yakap.actor_email', true)\n  )\n) AND \"letters\".\"status\" <> 'deleted'",
        "withCheck": "(\n  current_setting('yakap.scope', true) = 'moderation' AND EXISTS (\n    SELECT 1 FROM public.moderators WHERE email = current_setting('yakap.actor_email', true)\n  )\n) AND \"letters\".\"status\" IN ('approved', 'declined', 'deleted')",
        "entityType": "policies"
      }
